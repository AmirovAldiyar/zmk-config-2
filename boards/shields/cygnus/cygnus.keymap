#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&mt {
    quick-tap-ms = <175>;
    flavor = "balanced";
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
};

&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        change_input {
            bindings = <&kp LS(LALT)>;
            key-positions = <34 35>;
        };

        move_window {
            bindings = <&kp LS(LG(LEFT))>;
            key-positions = <2 7>;
        };

        esc_right {
            bindings = <&kp ESC>;
            key-positions = <17 18 16>;
        };

        esc_left {
            bindings = <&kp ESC>;
            key-positions = <11 12 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty {
            display-name = "BASE";
            bindings = <
                  &kp Q       &kp W           &kp E        &kp R        &kp T          &kp Y        &kp U            &kp I              &kp O       &kp P
&kp LEFT_BRACKET  &mt LGUI A  &mt LEFT_ALT S  &mt LSHFT D  &mt LCTRL F  &kp G          &kp H        &mt RCTRL J      &mt RSHFT K        &mt RALT L  &mt RGUI SEMI       &kp SQT
                  &kp Z       &kp X           &kp C        &kp V        &kp B          &kp N        &kp M            &kp COMMA          &kp DOT     &kp FSLH
                                              &kp DEL      &lt 2 TAB    &lt 1 SPACE    &lt 1 ENTER  &lt 2 BACKSPACE  &kp RIGHT_BRACKET
            >;
        };

        navigation {
            display-name = "NAV";
            bindings = <
        &none         &none       &kp UP    &none       &kp PG_DN     &kp PG_UP   &none           &kp UP                &none           &none
&tog 4  &kp LEFT_GUI  &kp LEFT    &kp DOWN  &kp RIGHT   &kp HOME      &kp END     &mt LCTRL LEFT  &mt LSHFT DOWN_ARROW  &mt RALT RIGHT  &kp LGUI     &tog 4
        &none         &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp INSERT    &caps_word  &kp C_VOL_DN    &kp C_MUTE            &kp C_VOL_UP    &none
                                  &none     &kp DEL     &trans        &trans      &kp BACKSPACE   &none
            >;
        };

        symbol {
            display-name = "SYMBOL";
            bindings = <
        &kp N1                 &kp N2                 &kp N3                   &kp N4                  &kp N5        &kp N6            &kp N7            &kp N8            &kp N9           &kp N0
&tog 3  &mt LGUI LS(NUMBER_1)  &mt LALT LS(NUMBER_2)  &mt LSHIFT LS(NUMBER_3)  &mt LCTRL LS(NUMBER_4)  &kp LS(N5)    &kp LS(NUMBER_6)  &mt RCTRL LS(N7)  &mt RSHFT LS(N8)  &mt RALT LS(N9)  &mt RGUI LS(N0)       &tog 3
        &kp KP_COMMA           &kp PIPE               &kp TILDE                &kp UNDER               &kp PLUS      &kp EQUAL         &kp MINUS         &kp GRAVE         &kp BACKSLASH    &kp KP_DOT
                                                      &none                    &trans                  &kp SPACE     &kp ENTER         &trans            &none
            >;
        };

        func {
            display-name = "ADJUST";
            bindings = <
       &mt F11 F1  &mt F12 F2  &mt F13 F3  &mt F14 F4  &mt F15 F5    &mt F16 F6  &mt F17 F7      &mt F18 F8  &mt F19 F9   &mt F20 F10
&none  &kp LGUI    &kp LALT    &kp LSHFT   &kp LCTRL   &none         &none       &kp RCTRL       &kp RSHFT   &kp RALT     &kp RGUI        &none
       &none       &bt BT_PRV  &bt BT_CLR  &bt BT_NXT  &none         &none       &studio_unlock  &soft_off   &bootloader  &none
                               &none       &tog 3      &none         &none       &tog 3          &none
            >;
        };

        game {
            display-name = "GAME";
            bindings = <
       &kp TAB    &kp Q  &kp W   &kp E     &kp R                                &kp C_VOL_UP  &kp Q     &kp UP    &kp E      &kp C_PP
&kp G  &kp LSHFT  &kp A  &kp S   &kp D     &kp F                                &kp C_VOL_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans    &kp M
       &kp LCTRL  &kp Z  &kp X   &kp C     &kp V                                &kp N1        &kp N2    &kp F2    &kp F5     &kp F6
                                 &trans    &kp LALT  &kp SPACE    &kp ENTER     &tog 4    &trans
            >;
        };
    };
};