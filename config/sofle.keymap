#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        change_input {
            bindings = <&kp LS(LEFT_ALT)>;
            key-positions = <54 55>;
        };

        move_window {
            bindings = <&kp LS(LG(LEFT_ARROW))>;
            key-positions = <15 20>;
        };

        l_esc {
            bindings = <&kp ESC>;
            key-positions = <26 27 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&kp MINUS  &kp N1      &kp N2      &kp N3       &kp N4       &kp N5                               &kp N6    &kp N7       &kp N8       &kp N9      &kp N0              &kp EQUAL
&kp TILDE  &kp Q       &kp W       &kp E        &kp R        &kp T                                &kp Y     &kp U        &kp I        &kp O       &kp P               &kp BACKSLASH
&kp GRAVE  &mt LGUI A  &mt LALT S  &mt LSHFT D  &mt LCTRL F  &kp G                                &kp H     &mt RCTRL J  &mt RSHFT K  &mt RALT L  &mt RGUI SEMICOLON  &kp APOS
&kp LBKT   &kp Z       &kp X       &kp C        &kp V        &kp B    &kp HOME       &kp C_MUTE   &kp N     &kp M        &kp COMMA    &kp DOT     &kp FSLH            &kp RBKT
                       &tog 2      &kp HOME     &kp DEL      &kp TAB  &lt 1 SPACE    &lt 1 ENTER  &kp BSPC  &kp CAPS     &kp END      &tog 2
            >;

            sensor-bindings =
                <&inc_dec_kp LC(RIGHT) LC(LEFT_ARROW)>,
                <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        NAV {
            bindings = <
&kp LGUI   &kp F1  &kp F2      &kp F3    &kp F4      &kp F5                                 &kp F6  &kp F7        &kp F8      &kp F9        &kp F10  &kp LGUI
&kp LALT   &none   &none       &kp UP    &none       &none                                  &none   &none         &kp UP      &none         &none    &kp RALT
&kp LSHFT  &none   &kp LEFT    &kp DOWN  &kp RIGHT   &none                                  &none   &kp LEFT      &kp DOWN    &kp RIGHT     &none    &kp RSHFT
&kp LCTRL  &none   &kp C_PREV  &kp C_PP  &kp C_NEXT  &none   &rgb_ug RGB_TOG    &bl BL_TOG  &none   &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &none    &kp RCTRL
                   &none       &none     &none       &none   &none              &none       &none   &none         &none       &none
            >;
        };

        layer_2 {
            bindings = <
&kp  &kp  &rgb_ug RGB_HUD  &kp  &rgb_ug RGB_HUI  &kp              &kp  &kp         &kp         &kp         &kp  &kp
&kp  &kp  &rgb_ug RGB_SAD  &kp  &rgb_ug RGB_SAI  &kp              &kp  &kp         &kp         &kp         &kp  &kp
&kp  &kp  &rgb_ug RGB_BRD  &kp  &rgb_ug RGB_BRI  &kp              &kp  &kp         &kp         &kp         &kp  &kp
&kp  &kp  &rgb_ug RGB_EFR  &kp  &rgb_ug RGB_EFF  &kp  &kp    &kp  &kp  &bt BT_PRV  &bt BT_CLR  &bt BT_NXT  &kp  &kp
          &tog 2           &kp  &none            &kp  &kp    &kp  &kp  &kp         &kp         &kp
            >;
        };
    };
};
